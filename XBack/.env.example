# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/xsusu

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# Encryption (32 characters)
ENCRYPTION_KEY=your-32-character-encryption-key

# Allowed Origins
ALLOWED_ORIGINS=http://localhost:19000,exp://

# SMS Provider
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=XSusu

# Paystack
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# Expo Push Notifications (optional but recommended for production)
EXPO_ACCESS_TOKEN=replace_with_expo_access_token

# Expo access token is used by the backend when sending push notifications.